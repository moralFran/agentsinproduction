 // Close closes Writer and a Compressor instance used under the hood (if it
 // implements io.Closer interface).
+//
+// Any data written but not flushed is flushed first. Whatever the Compressor
+// emits while closing (such as final deflate block, which differs between
+// implementations and Go versions) is discarded: according to PMCE specs a
+// message must end with the empty deflate block produced by Flush().
 func (w *Writer) Close() error {
 	if w.err != nil {
 		return w.err
 	}
+	if w.dirty {
+		if err := w.Flush(); err != nil {
+			return err
+		}
+	}
 	if c, ok := w.c.(io.Closer); ok {
+		w.cbuf.dst = io.Discard
 		w.err = c.Close()
