+    gate_failed = netgate_enabled() and not (gate and json.loads(gate[-1][8:]).get("ok"))
     # Only the final record of each kind belongs to the harness, not an earlier line printed by a command.
     for tag in ("EXECUTOR ", "RESULT "):
