RESULT {"run": "v2-int-e88f0806-r1", "case": "gobwas-ws-a567dfd6", "model": "claude-sonnet-5-5", "outcome": "finished", "model_calls": 11, "tool_calls": 11, "in_tok": 24, "cache_write": 26883, "cache_read": 77514, "out_tok": 6579, "model_s": 67.61, "tool_s": 653.92, "commands": [{"cmd": "cd wsflate; grep -rn \"stream tail\" . | head; git log --oneline | head -3; git status --short", "rc": 0, "s": 0.31}, {"cmd": "cd wsflate; sed -n 1,200p writer.go; grep -n \"tail\\|Tail\" *.go | head -30", "rc": 0, "s": 0.11}, {"cmd": "cd wsflate; cat cbuf.go; sed -n 1,60p writer_test.go; git diff HEAD --stat; grep -n \"Close\\|Flush\" ../tests/deflate_test.go helper*.go", "rc": 0, "s": 0.27}, {"cmd": "cd wsflate; sed -n 165,200p helper.go", "rc": 0, "s": 0.12}, {"cmd": "cd wsflate; python3 - <<'E'\ns=open('writer.go').read()\ns=s.replace(\"\"\"\t\tw.err = c.Close()\n\t}\n\tw.checkTail()\n\"\"\",\"\"\"\t\tw.err = c.Close()\n\t}\n\"\"\")\nopen('writer.go','w').write(s)\nE\ncd ..; go test -count=1 github.com/gobwas/ws/tests github.com/gobwas/ws/wsflate 2>&1 | tail -15", "rc": 127, "s": 0.26}, {"cmd": "export PATH=$PATH:/usr/local/go/bin:~/go/bin; go test -count=1 github.com/gobwas/ws/tests github.com/gobwas/ws/wsflate 2>&1 | tail -15; git diff", "rc": 124, "s": 600.08}, {"cmd": "export PATH=$PATH:/usr/local/go/bin; git diff --stat; timeout 120 go test -count=1 -timeout 30s github.com/gobwas/ws/tests github.com/gobwas/ws/wsflate 2>&1 | head -50", "rc": 1, "s": 33.21}, {"cmd": "sed -n 20,130p tests/deflate_test.go; cat wsflate/helper.go | sed -n 1,165p", "rc": 0, "s": 0.13}, {"cmd": "export PATH=$PATH:/usr/local/go/bin; go version; grep -n \"func (d \\*compressor) close\" -A25 /usr/local/go/src/compress/flate/deflate.go; cd /srv/ci/cases/gobwas-ws-a567dfd6/repo; git diff; ls; grep -rn \"Close\" wsflate/*.go | grep -v _test | head -20", "rc": 0, "s": 0.33}, {"cmd": "export PATH=$PATH:/usr/local/go/bin; grep -n \"writeStoredHeader\" -B2 -A18 /usr/local/go/src/compress/flate/huffman_bit_writer.go | head -60; cd /srv/ci/cases/gobwas-ws-a567dfd6/repo; git stash -q; cat > /tmp/x_test.go <<'E'\nE\ncat go.mod", "rc": 0, "s": 0.39}, {"cmd": "export PATH=$PATH:/usr/local/go/bin; git stash pop -q; python3 - <<'E'\np='wsflate/writer.go'\ns=open(p).read()\ns=s.replace(\"\"\"\tcbuf cbuf\n\terr  error\n}\"\"\",\"\"\"\tcbuf cbuf\n\terr  error\n\n\t// dirty reports whether there is data written to the compressor which has\n\t// not been flushed yet.\n\tdirty bool\n}\"\"\")\ns=s.replace(\"\"\"\tw.err = nil\n\tw.cbuf.reset(dest)\"\"\",\"\"\"\tw.err = nil\n\tw.dirty = false\n\tw.cbuf.reset(de", "rc": 0, "s": 18.69}], "final_text": "**Root cause:** `wsflate.Writer.Close()` checked that the compressor's output ended in the `00 00 ff ff` sync-flush tail. It did this after `Close()` had already written the compressor's final block through the 4-byte tail buffer (`cbuf`).\n\nThe old check only passed because older Go's `flate.Writer.Close()` wrote `01 00 00 ff ff`, which also ends in `00 00 ff ff`. This environment's Go (1.27) writes just `03 00`. The last four bytes then became `ff ff 03 00`, which gave the \"unexpected stream tail\" error. Even with the check removed, the 4-byte buffer would have dropped the wrong bytes. That corrupted the message, and the server in `TestFlateClientServer` hung.\n\n**Fix** (in `wsflate/writer.go` and `wsflate/cbuf.go`):\n- `Writer` now tracks whether any data has been written since the last `Flush`.\n- `Close()` first flushes if there is unflushed data, which also checks the tail.\n- `Close()` then closes the compressor with its output discarded. A permessage-deflate message must end with the sync-flush tail, which the reader re-appends, and the final block must not be part of it. This no longer depends on which bytes a given Go version emits.\n\n`go test -count=1 github.com/gobwas/ws/tests github.com/gobwas/ws/wsflate` now passes, and `go vet ./wsflate` and `gofmt` are clean.", "patch": "diff --git a/wsflate/cbuf.go b/wsflate/cbuf.go\nindex 5e2c445..d272bfd 100644\n--- a/wsflate/cbuf.go\n+++ b/wsflate/cbuf.go\n@@ -11,6 +11,9 @@ type cbuf struct {\n \tn   int\n \tdst io.Writer\n \terr error\n+\n+\t// discard makes cbuf drop all written bytes.\n+\tdiscard bool\n }\n \n // Write implements io.Writer interface.\n@@ -18,6 +21,9 @@ func (c *cbuf) Write(p []byte) (int, error) {\n \tif c.err != nil {\n \t\treturn 0, c.err\n \t}\n+\tif c.discard {\n+\t\treturn len(p), nil\n+\t}\n \thead, tail := c.split(p)\n \tn := c.n + len(tail)\n \tif n > len(c.buf) {\n@@ -53,6 +59,7 @@ func (c *cbuf) split(p []byte) (head, tail []byte) {\n func (c *cbuf) reset(dst io.Writer) {\n \tc.n = 0\n \tc.err = nil\n+\tc.discard = false\n \tc.buf = [4]byte{0, 0, 0, 0}\n \tc.dst = dst\n }\ndiff --git a/wsflate/writer.go b/wsflate/writer.go\nindex 0342ccb..ded6f9f 100644\n--- a/wsflate/writer.go\n+++ b/wsflate/writer.go\n@@ -55,6 +55,10 @@ type Writer struct {\n \tc    Compressor\n \tcbuf cbuf\n \terr  error\n+\n+\t// dirty reports whether there is data written to the compressor which has\n+\t// not been flushed yet.\n+\tdirty bool\n }\n \n // NewWriter returns a new Writer.\n@@ -74,6 +78,7 @@ func NewWriter(w io.Writer, ctor func(io.Writer) Compressor) *Writer {\n // Any not flushed data will be lost.\n func (w *Writer) Reset(dest io.Writer) {\n \tw.err = nil\n+\tw.dirty = false\n \tw.cbuf.reset(dest)\n \tif x, ok := w.c.(WriteResetter); ok {\n \t\tx.Reset(&w.cbuf)\n@@ -88,6 +93,7 @@ func (w *Writer) Write(p []byte) (n int, err error) {\n \t\treturn 0, w.err\n \t}\n \tn, w.err = w.c.Write(p)\n+\tw.dirty = true\n \treturn n, w.err\n }\n \n@@ -98,6 +104,7 @@ func (w *Writer) Flush() error {\n \t}\n \tw.err = w.c.Flush()\n \tw.checkTail()\n+\tw.dirty = false\n \treturn w.err\n }\n \n@@ -107,10 +114,20 @@ func (w *Writer) Close() error {\n \tif w.err != nil {\n \t\treturn w.err\n \t}\n+\tif w.dirty {\n+\t\t// Make sure the message is properly terminated by the flush tail.\n+\t\tif err := w.Flush(); err != nil {\n+\t\t\treturn err\n+\t\t}\n+\t}\n \tif c, ok := w.c.(io.Closer); ok {\n+\t\t// Closing a compressor emits a final block, whose exact bytes depend\n+\t\t// on the compressor implementation. PMCE message must end with the\n+\t\t// (stripped) flush tail, so everything written on Close is dropped.\n+\t\tw.cbuf.discard = true\n \t\tw.err = c.Close()\n+\t\tw.cbuf.discard = false\n \t}\n-\tw.checkTail()\n \treturn w.err\n }\n \n", "total_s": 722.75}
